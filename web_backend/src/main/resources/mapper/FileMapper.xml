<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hiking.treasure.mapper.FileMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.hiking.treasure.entity.File">
        <id column="id" property="id" />
        <result column="file_name" property="fileName" />
        <result column="url" property="url" />
        <result column="object_name" property="objectName" />
        <result column="content_type" property="contentType" />
        <result column="file_size" property="fileSize" />
        <result column="storage_type" property="storageType" />
        <result column="md5" property="md5" />
        <result column="status" property="status" />
        <result column="del_flag" property="delFlag" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, file_name, url, object_name, content_type, file_size, storage_type, md5, status, del_flag, create_by, create_time, update_by, update_time
    </sql>

</mapper>
