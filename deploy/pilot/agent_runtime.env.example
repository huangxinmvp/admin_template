# Copy to deploy/pilot/agent_runtime.env, adjust for your Compose pilot host,
# and restrict to owner-only permissions such as:
# chmod 600 deploy/pilot/agent_runtime.env
# These values are loaded into the runtime container.

AGENT_RUNTIME_HOST=0.0.0.0
AGENT_RUNTIME_PORT=8091

AGENT_RUNTIME_API_KEY=change-this-shared-runtime-key
AGENT_RUNTIME_PROVIDER=mock
AGENT_RUNTIME_MODEL=mock-suggestion-v1
AGENT_RUNTIME_TIMEOUT_SECONDS=20
AGENT_RUNTIME_ALLOW_MOCK_FALLBACK=false

# Only needed by the non-Compose fallback helper scripts.
# AGENT_RUNTIME_PYTHON_BIN=/opt/aicoos/agent_runtime/.venv/bin/python

# Only required when AGENT_RUNTIME_PROVIDER=openai_compatible.
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
