# Copy to deploy/pilot/compose.env, adjust for the pilot host, and restrict to
# owner-only permissions such as:
# chmod 600 deploy/pilot/compose.env

COMPOSE_PROJECT_NAME=aicoos-pilot
TZ=Asia/Shanghai

MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=admin_template
# Keep MYSQL_APP_USER and MYSQL_APP_PASSWORD aligned with
# DB_USERNAME and DB_PASSWORD in backend.env.
MYSQL_APP_USER=aicoos_app
MYSQL_APP_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_VOLUME_NAME=aicoos-pilot-mysql-data

BACKEND_IMAGE=aicoos-backend:pilot
AGENT_RUNTIME_IMAGE=aicoos-agent-runtime:pilot
FRONTEND_IMAGE=aicoos-frontend:pilot

# Override these per host if Docker Hub vs mirror access differs.
BACKEND_BASE_IMAGE=docker.m.daocloud.io/library/maven:3.9.9-eclipse-temurin-21
RUNTIME_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
FRONTEND_NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-bookworm-slim
FRONTEND_NGINX_BASE_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

BACKEND_ENV_FILE=./backend.env
AGENT_RUNTIME_ENV_FILE=./agent_runtime.env

PILOT_DB_BIND_HOST=127.0.0.1
PILOT_DB_PORT=3306
PILOT_RUNTIME_BIND_HOST=127.0.0.1
PILOT_RUNTIME_PORT=8091
PILOT_BACKEND_BIND_HOST=127.0.0.1
PILOT_BACKEND_PORT=8081
PILOT_FRONTEND_BIND_HOST=0.0.0.0
PILOT_FRONTEND_PORT=8080

AICOOS_NETWORK_NAME=aicoos-pilot

PILOT_LOG_MAX_SIZE=10m
PILOT_LOG_MAX_FILE=3
PILOT_MYSQL_STOP_GRACE_PERIOD=60s
PILOT_RUNTIME_STOP_GRACE_PERIOD=20s
PILOT_BACKEND_STOP_GRACE_PERIOD=45s
PILOT_FRONTEND_STOP_GRACE_PERIOD=15s

# Leave blank for same-origin nginx -> backend proxying.
FRONTEND_API_BASE_URL=
