# Copy to deploy/pilot/backend.env, adjust for your Compose pilot host, and
# restrict to owner-only permissions such as:
# chmod 600 deploy/pilot/backend.env
# These values are loaded into the backend container. Internal service addresses
# should use Compose DNS names, not 127.0.0.1.

SERVER_PORT=8081

DB_URL=jdbc:mysql://mysql:3306/admin_template?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Keep DB_USERNAME and DB_PASSWORD aligned with MYSQL_APP_USER and
# MYSQL_APP_PASSWORD in compose.env.
DB_USERNAME=aicoos_app
DB_PASSWORD=change-this-db-password

APP_JWT_SECRET=change-this-jwt-secret-with-strong-random-value

# Env-first pilot recommendation: keep secrets here and let environment values
# override database system-config when both are present.
AICOOS_CONFIG_AGENT_RUNTIME_ENABLED=true
AICOOS_CONFIG_AGENT_RUNTIME_BASE_URL=http://agent-runtime:8091
AICOOS_CONFIG_AGENT_RUNTIME_API_KEY=change-this-shared-runtime-key
AICOOS_CONFIG_AGENT_RUNTIME_TIMEOUT_MS=8000

# Optional pilot overrides for runtime behavior.
AICOOS_CONFIG_AGENT_RUNTIME_PROVIDER=mock
AICOOS_CONFIG_AGENT_RUNTIME_MODEL=mock-suggestion-v1
AICOOS_CONFIG_AGENT_RUNTIME_MOCK_MODE=false

# Optional external integrations.
# AICOOS_CONFIG_INTEGRATION_LINEAR_ENABLED=false
# AICOOS_CONFIG_INTEGRATION_LINEAR_API_KEY=
# AICOOS_CONFIG_INTEGRATION_LINEAR_DEFAULT_TEAM_ID=
# AICOOS_CONFIG_INTEGRATION_FIGMA_ENABLED=false
# AICOOS_CONFIG_INTEGRATION_FIGMA_API_KEY=
